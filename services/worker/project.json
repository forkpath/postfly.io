{
  "name": "worker",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "services/worker/src",
  "projectType": "application",
  "tags": ["type:app", "runtime:node", "domain:composition"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/services/worker"],
      "options": {
        "command": "webpack-cli build --config-node-env production",
        "cwd": "services/worker"
      },
      "configurations": {
        "development": {
          "command": "webpack-cli build --config-node-env development"
        }
      }
    },
    "package": {
      "dependsOn": ["build"],
      "executor": "nx:noop",
      "cache": false
    },
    "serve": {
      "continuous": true,
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "dependsOn": [],
      "options": {
        "buildTarget": "worker:build",
        "runBuildTargetDependencies": false,
        "inspect": false
      },
      "configurations": {
        "development": {
          "buildTarget": "worker:build:development"
        },
        "production": {
          "buildTarget": "worker:build:production"
        }
      }
    },
    "lint": {
      "cache": true,
      "executor": "nx:run-commands",
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/eslint.config.mjs",
        "{workspaceRoot}/services/worker/eslint.config.mjs",
        {
          "externalDependencies": ["eslint"]
        }
      ],
      "outputs": ["{options.outputFile}"],
      "options": {
        "cwd": "services/worker",
        "command": "eslint ."
      }
    },
    "test": {
      "cache": true,
      "executor": "nx:run-commands",
      "inputs": [
        "default",
        "^production",
        {
          "externalDependencies": ["vitest"]
        },
        {
          "env": "CI"
        },
        "unitTestGlobals"
      ],
      "outputs": ["{workspaceRoot}/dist/test-results/worker/unit", "{workspaceRoot}/coverage/services/worker"],
      "options": {
        "cwd": "services/worker",
        "command": "vitest"
      }
    },
    "typecheck": {
      "cache": true,
      "executor": "nx:run-commands",
      "inputs": [
        "production",
        "^production",
        {
          "externalDependencies": ["typescript"]
        }
      ],
      "options": {
        "cwd": "services/worker",
        "command": "tsc --noEmit -p tsconfig.app.json"
      }
    },
    "test-integration": {
      "executor": "nx:run-commands",
      "cache": false,
      "outputs": ["{workspaceRoot}/dist/test-results/worker/integration"],
      "options": {
        "command": "node scripts/testing/run-backend.mjs worker integration"
      }
    },
    "integration-run": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "vitest run --config vitest.integration.config.mts",
        "cwd": "services/worker"
      }
    },
    "e2e": {
      "executor": "nx:run-commands",
      "cache": false,
      "outputs": ["{workspaceRoot}/dist/test-results/worker/e2e"],
      "options": {
        "command": "node scripts/testing/run-backend.mjs worker e2e"
      }
    },
    "e2e-run": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "vitest run --config vitest.e2e.config.mts",
        "cwd": "services/worker"
      },
      "dependsOn": ["e2e-process-build"]
    },
    "typecheck-tests": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p tsconfig.spec.json",
        "cwd": "services/worker"
      }
    },
    "e2e-process-build": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "webpack-cli build --config webpack.e2e.config.js --config-node-env test",
        "cwd": "services/worker"
      }
    }
  }
}
