{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "module": "commonjs",
    "types": ["node"],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "target": "es2021",
    "moduleResolution": "node",
    "paths": {
      "#/*": ["services/engine/src/*"],
      "@libs/srv-core": ["libs/srv-core/src/index.ts"],
      "@libs/srv-shared": ["libs/srv-shared/src/index.ts"],
      "@libs/mongo-dao": ["libs/mongo-dao/src/index.ts"],
      "@libs/pg-dao": ["libs/pg-dao/src/index.ts"],
      "@libs/payload": ["libs/payload/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts"]
}
