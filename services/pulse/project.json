{
  "name": "pulse",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "services/pulse/src",
  "projectType": "application",
  "tags": ["type:app", "runtime:node", "domain:composition"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/services/pulse"],
      "options": {
        "command": "webpack-cli build --config-node-env production",
        "cwd": "services/pulse"
      },
      "configurations": {
        "development": {
          "command": "webpack-cli build --config-node-env development"
        }
      }
    },
    "prune-lockfile": {
      "dependsOn": ["build"],
      "cache": true,
      "executor": "@nx/js:prune-lockfile",
      "outputs": [
        "{workspaceRoot}/dist/services/pulse/package.json",
        "{workspaceRoot}/dist/services/pulse/pnpm-lock.yaml"
      ],
      "options": {
        "buildTarget": "build",
        "outputPath": "dist/services/pulse"
      }
    },
    "copy-workspace-modules": {
      "dependsOn": ["build"],
      "cache": true,
      "outputs": ["{workspaceRoot}/dist/services/pulse/workspace_modules"],
      "executor": "@nx/js:copy-workspace-modules",
      "options": {
        "buildTarget": "build",
        "outputPath": "dist/services/pulse"
      }
    },
    "prune": {
      "dependsOn": ["prune-lockfile", "copy-workspace-modules"],
      "executor": "nx:noop"
    },
    "package": {
      "dependsOn": ["prune-lockfile", "copy-workspace-modules"],
      "executor": "nx:noop"
    },
    "serve": {
      "continuous": true,
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "dependsOn": ["build"],
      "options": {
        "buildTarget": "pulse:build",
        "runBuildTargetDependencies": false
      },
      "configurations": {
        "development": {
          "buildTarget": "pulse:build:development"
        },
        "production": {
          "buildTarget": "pulse:build:production"
        }
      }
    },
    "lint": {
      "cache": true,
      "executor": "nx:run-commands",
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/eslint.config.mjs",
        "{workspaceRoot}/services/pulse/eslint.config.mjs",
        "{workspaceRoot}/tools/eslint-rules/**/*",
        {
          "externalDependencies": ["eslint"]
        }
      ],
      "outputs": ["{options.outputFile}"],
      "options": {
        "cwd": "services/pulse",
        "command": "eslint ."
      }
    },
    "test": {
      "cache": true,
      "executor": "nx:run-commands",
      "inputs": [
        "default",
        "^production",
        {
          "externalDependencies": ["vitest"]
        },
        {
          "env": "CI"
        }
      ],
      "outputs": ["{workspaceRoot}/coverage/services/pulse"],
      "options": {
        "cwd": "services/pulse",
        "command": "vitest"
      }
    },
    "typecheck": {
      "cache": true,
      "executor": "nx:run-commands",
      "inputs": [
        "production",
        "^production",
        {
          "externalDependencies": ["typescript"]
        }
      ],
      "options": {
        "cwd": "services/pulse",
        "command": "tsc --noEmit -p tsconfig.app.json"
      }
    }
  }
}
