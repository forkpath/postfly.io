{
  "name": "pulse",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "services/pulse/src",
  "projectType": "application",
  "tags": ["type:app", "runtime:node", "domain:composition"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/services/pulse"],
      "options": {
        "command": "webpack-cli build --config-node-env production",
        "cwd": "services/pulse"
      },
      "configurations": {
        "development": {
          "command": "webpack-cli build --config-node-env development"
        }
      }
    },
    "package": {
      "dependsOn": ["build"],
      "executor": "nx:noop",
      "cache": false
    },
    "serve": {
      "continuous": true,
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "dependsOn": [],
      "options": {
        "buildTarget": "pulse:build",
        "runBuildTargetDependencies": false,
        "inspect": false
      },
      "configurations": {
        "development": {
          "buildTarget": "pulse:build:development"
        },
        "production": {
          "buildTarget": "pulse:build:production"
        }
      }
    },
    "lint": {
      "cache": true,
      "executor": "nx:run-commands",
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/eslint.config.mjs",
        "{workspaceRoot}/services/pulse/eslint.config.mjs",
        {
          "externalDependencies": ["eslint"]
        }
      ],
      "outputs": ["{options.outputFile}"],
      "options": {
        "cwd": "services/pulse",
        "command": "eslint ."
      }
    },
    "test": {
      "cache": true,
      "executor": "nx:run-commands",
      "inputs": [
        "default",
        "^production",
        {
          "externalDependencies": ["vitest"]
        },
        {
          "env": "CI"
        },
        "unitTestGlobals"
      ],
      "outputs": ["{workspaceRoot}/dist/test-results/pulse/unit", "{workspaceRoot}/coverage/services/pulse"],
      "options": {
        "cwd": "services/pulse",
        "command": "vitest"
      }
    },
    "typecheck": {
      "cache": true,
      "executor": "nx:run-commands",
      "inputs": [
        "production",
        "^production",
        {
          "externalDependencies": ["typescript"]
        }
      ],
      "options": {
        "cwd": "services/pulse",
        "command": "tsc --noEmit -p tsconfig.app.json"
      }
    },
    "test-integration": {
      "executor": "nx:run-commands",
      "cache": false,
      "outputs": ["{workspaceRoot}/dist/test-results/pulse/integration"],
      "options": {
        "command": "node scripts/testing/run-backend.mjs pulse integration"
      }
    },
    "integration-run": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "vitest run --config vitest.integration.config.mts",
        "cwd": "services/pulse"
      }
    },
    "e2e": {
      "executor": "nx:run-commands",
      "cache": false,
      "outputs": ["{workspaceRoot}/dist/test-results/pulse/e2e"],
      "options": {
        "command": "node scripts/testing/run-backend.mjs pulse e2e"
      }
    },
    "e2e-run": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "vitest run --config vitest.e2e.config.mts",
        "cwd": "services/pulse"
      }
    },
    "typecheck-tests": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p tsconfig.spec.json",
        "cwd": "services/pulse"
      }
    }
  }
}
