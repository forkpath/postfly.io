// Ownership is an application boundary, not a Prisma relation to generated auth models.
// Account/org deletion must explicitly choose retention or resource cleanup before deployment.
model <%= className %> {
  id String @id @db.Uuid
  <%= ownerField %> String @map("<%= ownerColumn %>")
  title String @db.VarChar(120)
  description String? @db.VarChar(2000)
  createdAt DateTime @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @map("updated_at") @db.Timestamptz(3)

  @@index([<%= ownerField %>, createdAt, id], map: "<%= table %>_owner_created_idx")
  @@map("<%= table %>")
  @@schema("public")
}
