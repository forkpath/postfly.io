{
  "name": "skills-maintenance",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "tags": ["type:app", "runtime:node", "domain:composition"],
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default"],
      "outputs": [],
      "options": {
        "command": "node --test tools/skills-maintenance/*.test.mjs"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default"],
      "outputs": [],
      "options": {
        "command": "eslint tools/skills-maintenance"
      }
    },
    "validate": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/.agents/**/*",
        "{workspaceRoot}/AGENTS.md",
        "{workspaceRoot}/.cursor/rules/**/*"
      ],
      "outputs": [],
      "options": {
        "command": "node tools/skills-maintenance/cli.mjs validate"
      }
    },
    "upstream-check": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node tools/skills-maintenance/cli.mjs check"
      }
    },
    "behavior-evidence": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": { "command": "node tools/skills-maintenance/evidence.mjs" }
    },
    "candidates": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": { "command": "node tools/skills-maintenance/candidates.mjs" }
    },
    "agent-evaluation": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": { "command": "node tools/skills-maintenance/run-agent.mjs" }
    },
    "verify-generated": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": { "command": "node tools/skills-maintenance/evaluation/verify-generated.mjs" }
    },
    "mutation-check": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": { "command": "node tools/skills-maintenance/evaluation/mutate-generated.mjs" }
    },
    "evaluation-scope": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": { "command": "node tools/skills-maintenance/evaluation/scope.mjs" }
    },
    "prepare": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node tools/skills-maintenance/cli.mjs prepare"
      }
    },
    "sync-check": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node tools/skills-maintenance/cli.mjs sync-check"
      }
    },
    "sync": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node tools/skills-maintenance/cli.mjs sync"
      }
    }
  }
}
