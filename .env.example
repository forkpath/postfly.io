# PRODUCT
PRODUCT_NAME=ray

# Engine
ENGINE_PORT=8000
# CORS_ORIGINS: 跨域允许的源，多个用逗号分隔
# 注意：使用 '*' 时不支持 credentials（cookie），如需认证请指定具体域名
# 开发环境示例: 'http://localhost:3000,http://localhost:4200'
CORS_ORIGINS='http://localhost:3000,http://localhost:4200'

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=123QWEasd

# Cache, 用redis作为缓存介质，所以会复用上面的redis连接
CACHE_TTL=7200000 #2小时 = 1000毫秒 * 60 * 60 * 2
CACHE_DB_INDEX=1

# Logger 日志配置
LOGGER_LEVEL=info #日志级别
LOGGER_SCOPE=ray
LOGGER_FILE_ENABLED=true
LOGGER_FILE_SIZE_LIMIT=20M #日志文件大小限制:`${number}B` | `${number}K` | `${number}M` | `${number}G`
LOGGER_FILE_EXPIRED_IN=14d #日志文件过期时间:`${number}M` | `${number}d` | `${number}h` | `${number}m` | `${number}s`
LOGGER_FILE_COMPRESS=true #日志是否压缩

# I18n
DEFAULT_LOCALE=en # zh或者en
VITE_DEFAULT_LOCALE=en
LOCALE_PATH=/asset

# Postgresql
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=ray_user
POSTGRES_PASSWORD=ray_password
POSTGRES_DB=ray
POSGTRES_DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?connect_timeout=300&sslmode=prefer"

# Mongo
MONGO_HOST=127.0.0.1
MONGO_PORT=27017
MONGO_INITDB_ROOT_USERNAME=ray_user
MONGO_INITDB_ROOT_PASSWORD=ray_password
MONGO_INITDB_DATABASE=ray

# Throttler 使用redis作为存储介质,复用redis的连接信息
THROTTLER_TTL=60000 #60秒 = 1000毫秒 * 60
THROTTLER_LIMIT=100 #每60秒最大请求数
THROTTLER_STORAGE=redis
THROTTLER_DB_INDEX=2 #redis的db索引，根cache区分开

# Email 可以使用resend/aws-ses/aliyun-dm
EMAIL_FROM= #用户收到的邮件显示发送方
## 采用resend
RESEND_API_KEY
## 采用aws-ses
# AWS_SES_ACCESS_KEY_ID
# AWS_SES_ACCESS_KEY_SECRET
# AWS_SES_REGION
## 采用aliyun-dm
# ALIYUN_DM_ACCESS_KEY_ID
# ALIYUN_DM_ACCESS_KEY_SECRET
# ALIYUN_DM_ACCOUNT_NAME
# ALIYUN_DM_REPLY_TO_ADDRESS
# ALIYUN_DM_ADDRESS_TYPE


# Storage 可以使用oss或者s3
STORAGE_ACCESS_KEY_ID=your_oss_access_key_id
STORAGE_ACCESS_KEY_SECRET=your_oss_access_key_secret
STORAGE_BUCKET=your_oss_bucket
STORAGE_REGION=your_oss_region
STORAGE_END_POINT=your_oss_end_point
## 如果采用s3

# Better-Auth secret
BETTER_AUTH_SECRET=1b892d587256540d660afef5f319651e1f42e5cebc1d0d2f9ffeebf501b6d48e
## OAuth
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_APP_BUNDLE_IDENTIFIER=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
## 用于auth来生成测试账户密码
SEED_EMAIL=
SEED_PASSWORD=

# SMS,阿里云短信服务
SMS_ACCESS_KEY_ID=your_sms_access_key_id
SMS_ACCESS_KEY_SECRET=your_sms_access_key_secret
SMS_SIGN_NAME=your_sms_sign_name

# RabbitMQ
RABBITMQ_URI=amqp://${RABBITMQ_DEFAULT_USER}:${RABBITMQ_DEFAULT_PASSWORD}@rabbitmq:5672
RABBITMQ_EXCHANGE_NAME=ray_exchange
RABBITMQ_EXCHANGE_TYPE=direct
RABBITMQ_DEFAULT_USER=ray_user
RABBITMQ_DEFAULT_PASSWORD=ray_password

# Elasticsearch
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_API_KEY=your_elasticsearch_api_key
ELASTICSEARCH_MAX_RETRIES=3
ELASTICSEARCH_REQUEST_TIMEOUT=30000#30秒 = 1000毫秒 * 30
ELASTICSEARCH_DATA_INDEX=your_data_index

# Apple桌面应用签名
APPLE_ID=
APPLE_ID_PASSWORD=
APPLE_TEAM_ID=
APPLE_KEYCHAIN=

# Window桌面应用签名
CERTIFICATE_PATH=
CERTIFICATE_PASSWORD=