# ═══════════════════════════════════════════════════════════════════
#  Product / 基础配置
# ═══════════════════════════════════════════════════════════════════
PRODUCT_NAME=ray
# 生产域名，Kong ACME 插件使用此域名申请 Let's Encrypt 证书
DOMAIN=ray.example.com
# Let's Encrypt 证书通知邮箱（过期、续期失败会发邮件）
ACME_EMAIL=admin@example.com

WEB_PORT=3000
DESKTOP_PORT=4200
ENGINE_PORT=8000
# 允许跨域的前端域名，生产环境务必改为实际域名
CORS_ORIGINS='http://localhost:3000,http://localhost:4200'

# ═══════════════════════════════════════════════════════════════════
#  Vite 构建时注入的客户端变量（VITE_ 前缀）
#  Docker 构建时通过 --build-arg 注入到前端 JS 中
#  运行时 envin 也会通过 process.env 读取做校验
# ═══════════════════════════════════════════════════════════════════
# VITE_API_ENDPOINT=http://localhost:8000 # 配置web不通过proxy，直接访问后端接口
VITE_PRODUCT_NAME=Ray
VITE_URL=http://localhost:3000
VITE_API_BASE_URL=http://localhost:8000 # 后端 API / 认证服务地址，给extension和mobile用的
VITE_DEFAULT_LOCALE=en
VITE_THEME_MODE=system
VITE_THEME_COLOR=green

# ═══════════════════════════════════════════════════════════════════
#  Redis（Engine 缓存 / Kong ACME 证书 / 限流 / Throttler）
# ═══════════════════════════════════════════════════════════════════
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password

# ─── Cache（复用 Redis 连接，不同 db 索引）─────────────────────────
CACHE_TTL=7200000
CACHE_DB_INDEX=1

# ═══════════════════════════════════════════════════════════════════
#  Logger 日志配置
# ═══════════════════════════════════════════════════════════════════
LOGGER_LEVEL=info
LOGGER_SCOPE=ray
LOGGER_FILE_ENABLED=true
# 日志文件大小限制: ${number}B | ${number}K | ${number}M | ${number}G
LOGGER_FILE_SIZE_LIMIT=20M
# 日志文件过期时间: ${number}M | ${number}d | ${number}h | ${number}m | ${number}s
LOGGER_FILE_EXPIRED_IN=14d
LOGGER_FILE_COMPRESS=true

# ═══════════════════════════════════════════════════════════════════
#  I18n 国际化
# ═══════════════════════════════════════════════════════════════════
DEFAULT_LOCALE=en
VITE_DEFAULT_LOCALE=en
# Engine 运行时加载翻译文件的路径
LOCALE_PATH=libs/i18n/src/translations

# ═══════════════════════════════════════════════════════════════════
#  PostgreSQL（主数据库，Prisma ORM）
# ═══════════════════════════════════════════════════════════════════
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=ray_user
POSTGRES_PASSWORD=ray_password
POSTGRES_DB=ray
# docker-compose 中 engine 会覆盖此值指向容器内网地址
POSGTRES_DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?connect_timeout=300&sslmode=disable"

# ═══════════════════════════════════════════════════════════════════
#  MongoDB（文档型数据，Mongoose）
# ═══════════════════════════════════════════════════════════════════
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_INITDB_ROOT_USERNAME=ray_user
MONGO_INITDB_ROOT_PASSWORD=ray_password
MONGO_INITDB_DATABASE=ray

# ═══════════════════════════════════════════════════════════════════
#  Throttler 限流（复用 Redis）
# ═══════════════════════════════════════════════════════════════════
# 窗口时长（毫秒）
THROTTLER_TTL=60000
# 窗口内最大请求数
THROTTLER_LIMIT=100
THROTTLER_STORAGE=redis
# Redis db 索引，与 Cache 区分
THROTTLER_DB_INDEX=2

# ═══════════════════════════════════════════════════════════════════
#  Email 邮件服务（resend / aws-ses / aliyun-dm 三选一）
# ═══════════════════════════════════════════════════════════════════
EMAIL_FROM=noreply@example.com
# envin 必填，用于联系页面等
CONTACT_EMAIL=contact@example.com
## Resend
RESEND_API_KEY=re_xxx
## AWS SES（按需启用）
# AWS_SES_ACCESS_KEY_ID=
# AWS_SES_ACCESS_KEY_SECRET=
# AWS_SES_REGION=
## 阿里云邮件推送（按需启用）
# ALIYUN_DM_ACCESS_KEY_ID=
# ALIYUN_DM_ACCESS_KEY_SECRET=
# ALIYUN_DM_ACCOUNT_NAME=
# ALIYUN_DM_REPLY_TO_ADDRESS=
# ALIYUN_DM_ADDRESS_TYPE=

# ═══════════════════════════════════════════════════════════════════
#  Storage 对象存储（S3 兼容，用于头像等文件上传）
# ═══════════════════════════════════════════════════════════════════
STORAGE_ACCESS_KEY_ID=your_access_key
STORAGE_ACCESS_KEY_SECRET=your_secret_key
STORAGE_BUCKET=ray-storage
STORAGE_REGION=ap-southeast-1
# 留空则使用 AWS S3 默认端点；自定义 S3 兼容服务需填完整 URL
STORAGE_END_POINT=https://s3.ap-southeast-1.amazonaws.com

# ═══════════════════════════════════════════════════════════════════
#  Better Auth 认证
# ═══════════════════════════════════════════════════════════════════
# 用于签名 session token，生产环境务必替换为随机值
BETTER_AUTH_SECRET=your_random_secret_at_least_32_chars
# 生产环境必须设置为实际访问的 URL
BETTER_AUTH_URL=http://localhost:3000
## OAuth 第三方登录（按需启用）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
## Seed 账户（首次部署 db:seed 使用）
SEED_EMAIL=
SEED_PASSWORD=

# ═══════════════════════════════════════════════════════════════════
#  Stripe 支付（服务端 + 客户端）
# ═══════════════════════════════════════════════════════════════════
STRIPE_SECRET_KEY=sk_test_xxx
# Stripe Webhook 签名密钥，验证回调合法性
STRIPE_WEBHOOK_SECRET=whsec_xxx
# 前端使用的 Stripe 公钥
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
## Stripe Price IDs（按套餐在 Stripe Dashboard 创建后填入）
VITE_BILLING_STRIPE_PRICE_PREMIUM_LIFETIME=price_xxx
VITE_BILLING_STRIPE_PRICE_PREMIUM_MONTHLY=price_xxx
VITE_BILLING_STRIPE_PRICE_PREMIUM_YEARLY=price_xxx

# ═══════════════════════════════════════════════════════════════════
#  SMS 阿里云短信服务
# ═══════════════════════════════════════════════════════════════════
SMS_ACCESS_KEY_ID=your_sms_access_key_id
SMS_ACCESS_KEY_SECRET=your_sms_access_key_secret
SMS_SIGN_NAME=your_sms_sign_name

# ═══════════════════════════════════════════════════════════════════
#  RabbitMQ 消息队列
# ═══════════════════════════════════════════════════════════════════
RABBITMQ_DEFAULT_USER=ray_user
RABBITMQ_DEFAULT_PASSWORD=ray_password
RABBITMQ_URI=amqp://${RABBITMQ_DEFAULT_USER}:${RABBITMQ_DEFAULT_PASSWORD}@rabbitmq:5672
RABBITMQ_EXCHANGE_NAME=ray_exchange
RABBITMQ_EXCHANGE_TYPE=direct

# ═══════════════════════════════════════════════════════════════════
#  Elasticsearch 全文搜索
# ═══════════════════════════════════════════════════════════════════
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_API_KEY=your_elasticsearch_api_key
ELASTICSEARCH_MAX_RETRIES=3
ELASTICSEARCH_REQUEST_TIMEOUT=30000
ELASTICSEARCH_DATA_INDEX=your_data_index

# ═══════════════════════════════════════════════════════════════════
#  Kong / Konga 网关管理
# ═══════════════════════════════════════════════════════════════════
# Konga JWT token 签名密钥
KONGA_TOKEN_SECRET=ray-konga-secret

# ═══════════════════════════════════════════════════════════════════
#  Desktop 桌面应用签名（按需配置）
# ═══════════════════════════════════════════════════════════════════
## Apple
APPLE_ID=
APPLE_ID_PASSWORD=
APPLE_TEAM_ID=
APPLE_KEYCHAIN=
## Windows
CERTIFICATE_PATH=
CERTIFICATE_PASSWORD=
