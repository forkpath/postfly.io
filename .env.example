# STUDIO port
STUDIO_PORT=

# Code Signature for apple desktop
APPLE_ID
APPLE_ID_PASSWORD
APPLE_TEAM_ID
APPLE_KEYCHAIN

# Code signature for window desktop
CERTIFICATE_PATH
CERTIFICATE_PASSWORD

# Better-Auth secret
BETTER_AUTH_SECRET=1b892d587256540d660afef5f319651e1f42e5cebc1d0d2f9ffeebf501b6d48e

# Server
PORTAL_PORT=8000
CORS_ORIGINS=http://localhost:8000#如果支持多个origin跨域访问，一定要用逗号分隔，譬如http://localhost:3000,http://localhost:8080

# SECURITY
SECURITY_SALT_ROUND=10
SECURITY_ACCESS_TOKEN_SECRET=ne0secretk3y
SECURITY_ACCESS_TOKEN_EXPIRED=60m
SECURITY_REFRESH_TOKEN_EXPIRED=7d#刷新token过期时间，单位只能是d/h/m，分别表示天/小时/分钟

# Redis
REDIS_HOST=100.68.9.50
REDIS_PORT=6378
REDIS_PASSWORD=123QWEasd

# Postgresql
POSTGRES_HOST=100.68.9.50
POSTGRES_PORT=5430
POSTGRES_USER=neo_user
POSTGRES_PASSWORD=neo_password
POSTGRES_DB=neo
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?connect_timeout=300&sslmode=prefer"

# Mongo
MONGO_HOST=100.68.9.50
MONGO_PORT=27017
MONGO_INITDB_ROOT_USERNAME=neo_user
MONGO_INITDB_ROOT_PASSWORD=neo_password
MONGO_INITDB_DATABASE=neo

# Cache, 用redis作为缓存介质，所以会复用上面的redis连接
CACHE_TTL=7200000#2小时 = 1000毫秒 * 60 * 60 * 2
CACHE_DB_INDEX=1

# Logger 日志配置
LOGGER_LEVEL=info#日志级别
LOGGER_SCOPE=neo
LOGGER_FILE_ENABLED=true
LOGGER_FILE_SIZE_LIMIT=20M#日志文件大小限制:`${number}B` | `${number}K` | `${number}M` | `${number}G`
LOGGER_FILE_EXPIRED_IN=14d#日志文件过期时间:`${number}M` | `${number}d` | `${number}h` | `${number}m` | `${number}s`
LOGGER_FILE_COMPRESS=true#日志是否压缩

# I18n
I18N_FALLBACK_LANGUAGE=zh
I18N_LOCALE_PATH=/assets/i18n/

# Throttler 使用redis作为存储介质,复用redis的连接信息
THROTTLER_TTL=60000#60秒 = 1000毫秒 * 60
THROTTLER_LIMIT=100#每60秒最大请求数
THROTTLER_STORAGE=redis
THROTTLER_DB_INDEX=2#redis的db索引，根cache区分开

# Mail
MAIL_SMTP_HOST=smtpdm.aliyun.com
MAIL_SMTP_PORT=465
MAIL_SMTP_SECURE=true
MAIL_SMTP_ACCOUNT=noreply@neo.io
MAIL_SMTP_PASSWORD=your_email_password
MAIL_SMTP_FROM=noreply@neo.io

# OSS, 阿里云对象存储
OSS_ACCESS_KEY_ID=your_oss_access_key_id
OSS_ACCESS_KEY_SECRET=your_oss_access_key_secret
OSS_BUCKET=your_oss_bucket
OSS_REGION=your_oss_region
OSS_END_POINT=your_oss_end_point

# SMS,阿里云短信服务
SMS_ACCESS_KEY_ID=your_sms_access_key_id
SMS_ACCESS_KEY_SECRET=your_sms_access_key_secret
SMS_SIGN_NAME=your_sms_sign_name

# RabbitMQ
RABBITMQ_URI=amqp://neo_user:neo_password@rabbitmq:5672
RABBITMQ_EXCHANGE_NAME=neo_exchange
RABBITMQ_EXCHANGE_TYPE=direct

# Elasticsearch
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_API_KEY=your_elasticsearch_api_key
ELASTICSEARCH_MAX_RETRIES=3
ELASTICSEARCH_REQUEST_TIMEOUT=30000#30秒 = 1000毫秒 * 30
ELASTICSEARCH_DATA_INDEX=your_data_index
