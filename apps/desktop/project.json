{
  "name": "desktop",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/desktop/src",
  "projectType": "application",
  "tags": ["type:app", "runtime:web", "domain:composition"],
  "// targets": "to see all targets run: nx show project desktop --web",
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p tsconfig.json",
        "cwd": "apps/desktop"
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [],
      "options": {
        "command": "node scripts/dev.mjs",
        "cwd": "apps/desktop"
      }
    },
    "package": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["build"],
      "options": {
        "command": "node scripts/package.mjs",
        "cwd": "apps/desktop"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production", "viteBuildEnvironment"],
      "outputs": ["{projectRoot}/.vite"],
      "options": {
        "command": "vite build --mode bundle --config vite.main.config.ts && vite build --mode bundle --config vite.preload.config.ts && vite build --mode bundle --config vite.renderer.config.ts",
        "cwd": "apps/desktop"
      }
    },
    "release": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["build"],
      "options": {
        "command": "node scripts/package.mjs --release",
        "cwd": "apps/desktop"
      }
    },
    "package-dir": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["build"],
      "options": {
        "command": "node scripts/package.mjs --dir",
        "cwd": "apps/desktop"
      }
    },
    "publish": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [],
      "options": {
        "command": "node scripts/publish.mjs",
        "cwd": "apps/desktop"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": [],
      "options": {
        "command": "vitest run --config vitest.config.mts",
        "cwd": "apps/desktop"
      },
      "outputs": ["{workspaceRoot}/coverage/apps/desktop", "{workspaceRoot}/dist/desktop/test-results/unit.json"]
    },
    "e2e": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["build"],
      "options": {
        "command": "node scripts/e2e.mjs",
        "cwd": "apps/desktop"
      }
    },
    "smoke": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["package-dir"],
      "options": {
        "command": "node scripts/smoke.mjs",
        "cwd": "apps/desktop"
      }
    },
    "update-e2e": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["build"],
      "options": {
        "command": "node scripts/update-e2e.mjs",
        "cwd": "apps/desktop"
      }
    },
    "publish-test": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [],
      "options": {
        "command": "node scripts/publish-integration.mjs",
        "cwd": "apps/desktop"
      }
    }
  }
}
