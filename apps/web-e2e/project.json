{
  "name": "web-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/web-e2e/src",
  "tags": ["type:app", "runtime:node", "domain:composition"],
  "implicitDependencies": ["web"],
  "// targets": "to see all targets run: nx show project web-e2e --web",
  "targets": {
    "e2e": {
      "cache": false,
      "dependsOn": [{ "projects": ["web"], "target": "build" }]
    },
    "e2e-ci": {
      "cache": false
    },
    "e2e-ci--src/platform-critical-flows.spec.ts": {
      "cache": false
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": { "command": "tsc --noEmit -p tsconfig.json", "cwd": "apps/web-e2e" }
    }
  }
}
