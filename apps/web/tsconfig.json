{
  "compilerOptions": {
    "allowJs": false,
    "esModuleInterop": false,
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "types": ["vite/client", "vitest"],
    "paths": {
      "~/*": ["apps/web/src/*"],
      "@libs/common": ["libs/common/src/index.ts"],
      "@libs/payload": ["libs/payload/src/index.ts"],
      "@libs/auth": ["libs/auth/src/index.ts"],
      "@libs/auth/*": ["libs/auth/src/*"],
      "@libs/ui-shared/*": ["libs/ui-shared/src/*"],
      "@libs/studio": ["libs/studio/src/index.ts"],
      "@libs/i18n": ["libs/i18n/src/index.ts"],
      "@libs/api-core": ["libs/api-core/src/index.ts"],
      "@libs/analytics/*": ["libs/analytics/src/*"],
      "@libs/monitoring": ["libs/monitoring/src/index.ts"],
      "@libs/monitoring/*": ["libs/monitoring/src/*"],
      "@libs/api-client": ["libs/api-client/src/index.ts"]
    }
  },
  "files": [],
  "include": [],
  "references": [
    {
      "path": "./tsconfig.app.json"
    },
    {
      "path": "./tsconfig.spec.json"
    }
  ],
  "extends": "../../tsconfig.base.json"
}
