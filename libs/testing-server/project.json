{
  "name": "testing-server",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/testing-server/src",
  "projectType": "library",
  "tags": ["type:platform", "runtime:node", "domain:platform", "scope:testing"],
  "// targets": "to see all targets run: nx show project testing-server --web",
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "dependsOn": ["^typecheck"],
      "inputs": ["production", "^production"],
      "options": {
        "command": "tsc --noEmit -p tsconfig.lib.json",
        "cwd": "libs/testing-server"
      }
    },
    "typecheck-tests": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p tsconfig.spec.json",
        "cwd": "libs/testing-server"
      }
    },
    "test": {
      "outputs": ["{workspaceRoot}/dist/test-results/testing-server/unit"]
    }
  }
}
