{
  "name": "auth",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/auth/src",
  "projectType": "library",
  "tags": ["scope:shared", "type:lib"],
  "targets": {
    "generate-auth-schema": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpx @better-auth/cli@latest generate --config ./src/server.ts --output ../pg-dao/src/models/auth.prisma --yes",
        "cwd": "libs/auth",
        "env": {
          "NODE_OPTIONS": "-r tsconfig-paths/register",
          "TS_NODE_PROJECT": "tsconfig.json"
        }
      }
    },
    "seed": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx ./src/scripts/seed.ts",
        "cwd": "libs/auth",
        "env": {
          "NODE_OPTIONS": "-r tsconfig-paths/register",
          "TS_NODE_PROJECT": "tsconfig.json"
        }
      },
      "dependsOn": [
        {
          "projects": "pg-dao",
          "target": "generate"
        }
      ]
    }
  }
}
