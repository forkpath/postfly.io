{
  "name": "monitoring-server",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/monitoring-server/src",
  "projectType": "library",
  "tags": ["type:platform", "runtime:node", "domain:platform"],
  "// targets": "to see all targets run: nx show project monitoring-server --web",
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p tsconfig.lib.json",
        "cwd": "libs/monitoring-server"
      }
    },
    "typecheck-tests": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "^production"],
      "options": {
        "command": "tsc --noEmit -p tsconfig.spec.json",
        "cwd": "libs/monitoring-server"
      }
    }
  }
}
