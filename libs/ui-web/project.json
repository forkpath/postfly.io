{
  "name": "ui-web",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/ui-web/src",
  "projectType": "library",
  "tags": ["type:ui", "runtime:web", "domain:shared"],
  "// targets": "to see all targets run: nx show project ui-web --web",
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p tsconfig.lib.json",
        "cwd": "libs/ui-web"
      }
    },
    "typecheck-tests": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "^production"],
      "options": {
        "command": "tsc --noEmit -p tsconfig.spec.json",
        "cwd": "libs/ui-web"
      }
    }
  }
}
