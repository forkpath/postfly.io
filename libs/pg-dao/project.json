{
  "name": "pg-dao",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/pg-dao/src",
  "projectType": "library",
  "tags": ["scope:backend", "type:lib"],
  "// targets": "to see all targets run: nx show project pg-dao --web",
  "targets": {
    "prisma": {
      "command": "prisma",
      "options": {
        "cwd": "libs/pg-dao"
      }
    },
    "format": {
      "command": "prisma format --schema ./src",
      "options": {
        "cwd": "libs/pg-dao"
      }
    },
    "seed": {
      "command": "prisma db seed --config ./prisma.config.ts",
      "options": {
        "cwd": "libs/pg-dao"
      }
    },
    "studio": {
      "command": "prisma studio --config ./prisma.config.ts",
      "options": {
        "cwd": "libs/pg-dao"
      }
    },
    "generate": {
      "command": "prisma generate --schema ./src",
      "options": {
        "cwd": "libs/pg-dao"
      }
    },
    "migrate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "prisma migrate dev --schema ./src --name={args.name}",
        "cwd": "libs/pg-dao"
      }
    },
    "deploy": {
      "command": "prisma migrate deploy --schema ./src",
      "options": {
        "cwd": "libs/pg-dao"
      }
    },
    "push": {
      "command": "prisma db push --schema ./src --accept-data-loss",
      "options": {
        "cwd": "libs/pg-dao"
      }
    },
    "validate": {
      "command": "prisma validate --schema ./src",
      "options": {
        "cwd": "libs/pg-dao"
      }
    }
  }
}
