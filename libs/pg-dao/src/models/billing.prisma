enum SubscriptionStatus {
  active
  canceled
  incomplete
  incomplete_expired
  past_due
  paused
  trialing
  unpaid

  @@schema("billing")
}

enum PaymentStatus {
  pending
  succeeded
  failed

  @@schema("billing")
}

enum WebhookEventStatus {
  processed
  failed
  skipped

  @@schema("billing")
}

model WebhookEvent {
  id          String             @id @default(cuid())
  eventId     String             @map("event_id")
  provider    String
  type        String
  status      WebhookEventStatus
  error       String?
  processedAt DateTime           @default(now()) @map("processed_at")

  @@unique([eventId, provider])
  @@index([provider, type])
  @@index([processedAt])
  @@map("webhook_event")
  @@schema("billing")
}

model Customer {
  id            String         @id @default(cuid())
  referenceId   String         @map("reference_id")
  externalId    String         @map("external_id")
  provider      String
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  subscriptions Subscription[]
  orders        Order[]

  @@unique([referenceId, provider])
  @@unique([externalId, provider])
  @@map("customer")
  @@schema("billing")
}

model Subscription {
  id             String             @id @default(cuid())
  customerId     String             @map("customer_id")
  customer       Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  externalId     String             @map("external_id")
  variantId      String             @map("variant_id")
  status         SubscriptionStatus
  store          String
  periodStartsAt DateTime           @map("period_starts_at")
  periodEndsAt   DateTime           @map("period_ends_at")
  trialStartsAt  DateTime?          @map("trial_starts_at")
  trialEndsAt    DateTime?          @map("trial_ends_at")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  @@unique([externalId, store])
  @@map("subscription")
  @@schema("billing")
}

model Order {
  id         String        @id @default(cuid())
  customerId String        @map("customer_id")
  customer   Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  externalId String        @map("external_id")
  variantId  String        @map("variant_id")
  status     PaymentStatus
  store      String
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")

  @@unique([externalId, store])
  @@map("order")
  @@schema("billing")
}
