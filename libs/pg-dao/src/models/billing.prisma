enum SubscriptionStatus {
  active
  canceled
  incomplete
  incomplete_expired
  past_due
  paused
  trialing
  unpaid

  @@schema("billing")
}

enum PaymentStatus {
  pending
  succeeded
  failed

  @@schema("billing")
}

enum WebhookEventStatus {
  received
  processing
  processed
  failed
  skipped

  @@schema("billing")
}

model WebhookEvent {
  id          String             @id @default(cuid())
  eventId     String             @map("event_id")
  provider    String
  type        String
  status      WebhookEventStatus
  error       String?
  receivedAt   DateTime           @default(now()) @map("received_at")
  processedAt  DateTime?          @map("processed_at")
  lastAttemptAt DateTime?         @map("last_attempt_at")
  attemptCount Int                @default(0) @map("attempt_count")

  @@unique([eventId, provider])
  @@index([provider, type])
  @@index([receivedAt])
  @@index([status, lastAttemptAt], map: "webhook_event_status_attempt_idx")
  @@map("webhook_event")
  @@schema("billing")
}

model Customer {
  id            String         @id @default(cuid())
  userId        String?        @map("user_id")
  user          User?          @relation("UserBillingCustomers", fields: [userId], references: [id], onDelete: Restrict)
  organizationId String?       @map("organization_id")
  organization  Organization?  @relation("OrganizationBillingCustomers", fields: [organizationId], references: [id], onDelete: Restrict)
  externalId    String         @map("external_id")
  provider      String
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  subscriptions Subscription[]
  orders        Order[]

  @@unique([userId, provider], map: "customer_user_provider_unique")
  @@unique([organizationId, provider], map: "customer_organization_provider_unique")
  @@unique([externalId, provider])
  @@index([userId, provider], map: "customer_user_provider_idx")
  @@index([organizationId, provider], map: "customer_organization_provider_idx")
  @@map("customer")
  @@schema("billing")
}

model Subscription {
  id             String             @id @default(cuid())
  customerId     String             @map("customer_id")
  customer       Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  externalId     String             @map("external_id")
  variantId      String             @map("variant_id")
  status         SubscriptionStatus
  store          String
  periodStartsAt DateTime           @map("period_starts_at")
  periodEndsAt   DateTime           @map("period_ends_at")
  trialStartsAt  DateTime?          @map("trial_starts_at")
  trialEndsAt    DateTime?          @map("trial_ends_at")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  @@unique([externalId, store])
  @@index([customerId, status, createdAt], map: "subscription_customer_status_created_idx")
  @@map("subscription")
  @@schema("billing")
}

model Order {
  id         String        @id @default(cuid())
  customerId String        @map("customer_id")
  customer   Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  externalId String        @map("external_id")
  variantId  String        @map("variant_id")
  status     PaymentStatus
  store      String
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")

  @@unique([externalId, store])
  @@index([customerId, status, createdAt], map: "order_customer_status_created_idx")
  @@map("order")
  @@schema("billing")
}
