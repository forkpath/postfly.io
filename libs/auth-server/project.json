{
  "name": "auth-server",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/auth-server/src",
  "projectType": "library",
  "tags": ["type:platform", "runtime:node", "domain:auth"],
  "// targets": "to see all targets run: nx show project auth-server --web",
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p tsconfig.lib.json",
        "cwd": "libs/auth-server"
      }
    },
    "seed": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "tsx ./src/scripts/seed.ts",
        "cwd": "libs/auth-server",
        "env": {
          "NODE_OPTIONS": "-r tsconfig-paths/register",
          "TS_NODE_PROJECT": "tsconfig.json"
        }
      },
      "dependsOn": [
        {
          "projects": "pg-dao",
          "target": "generate"
        }
      ]
    },
    "schema-check": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "production",
        "^production",
        "{workspaceRoot}/scripts/auth/check-auth-schema.mjs",
        "{workspaceRoot}/libs/pg-dao/src/models/auth.prisma",
        "{workspaceRoot}/package.json",
        "{workspaceRoot}/pnpm-lock.yaml",
        "{workspaceRoot}/tools/auth-schema/package.json"
      ],
      "options": {
        "command": "node scripts/auth/check-auth-schema.mjs"
      }
    },
    "typecheck-tests": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "^production"],
      "options": {
        "command": "tsc --noEmit -p tsconfig.spec.json",
        "cwd": "libs/auth-server"
      }
    }
  }
}
