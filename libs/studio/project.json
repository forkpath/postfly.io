{
  "name": "studio",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/studio/src",
  "projectType": "library",
  "tags": ["type:feature", "runtime:web", "domain:composition"],
  "// targets": "to see all targets run: nx show project studio --web",
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": { "command": "tsc --noEmit -p tsconfig.lib.json", "cwd": "libs/studio" }
    },
    "typecheck-tests": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "^production"],
      "options": { "command": "tsc --noEmit -p tsconfig.spec.json", "cwd": "libs/studio" }
    }
  }
}
